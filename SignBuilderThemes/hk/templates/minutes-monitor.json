{
  "formatVersion": 2,
  "theme": "hk",
  "_hkGlow": { "type": "led" },
  "id": "minutes-monitor",
  "name": "JTIS above sign",
  "scheme": "blue",
  "minWidth": 190,
  "items": [
    { "type": "minutes", "position": "tab", "align": "left", "minutes": "12", "height": 8, "color": "#ffb000" },
    {
      "type": "row",
      "align": "center",
      "justify": "even",
      "items": [
        {
          "type": "column",
          "align": "center",
          "gap": 5,
          "items": [
            { "type": "text", "text": "Cross-Harbour Tunnel", "height": 16, "font": "HK Transport Medium" },
            { "type": "text", "text": "紅磡海底隧道", "height": 16, "font": "Source Han Sans HK Bold" }
          ]
        },
        { "type": "arrow", "direction": "down", "style": "overhead", "height": 26 }
      ]
    }
  ]
}
