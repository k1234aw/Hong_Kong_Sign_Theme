<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Configurations>Debug;Release</Configurations>
    <PublishConfigurationPath>Properties\PublishConfiguration.xml</PublishConfigurationPath>
  </PropertyGroup>

  <Import Project="$(CSII_TOOLPATH)\Mod.props" />
  <Import Project="$(CSII_TOOLPATH)\Mod.targets" />

  <PropertyGroup>
    <OriginalSignBuilderPath Condition="'$(OriginalSignBuilderPath)'==''">$(LocalModsPath)\SignBuilder\SignBuilder.dll</OriginalSignBuilderPath>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="Game"><Private>false</Private></Reference>
    <Reference Include="Colossal.Logging"><Private>false</Private></Reference>
    <Reference Include="Colossal.Core"><Private>false</Private></Reference>
    <Reference Include="Colossal.IO.AssetDatabase"><Private>false</Private></Reference>
    <Reference Include="Colossal.UI"><Private>false</Private></Reference>
    <Reference Include="Colossal.UI.Binding"><Private>false</Private></Reference>
    <Reference Include="Newtonsoft.Json"><Private>false</Private></Reference>
    <Reference Include="Unity.Entities"><Private>false</Private></Reference>
    <Reference Include="Unity.Collections"><Private>false</Private></Reference>
    <Reference Include="UnityEngine.CoreModule"><Private>false</Private></Reference>
    <Reference Include="SignBuilder">
      <HintPath>$(OriginalSignBuilderPath)</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Update="System"><Private>false</Private></Reference>
    <Reference Update="System.Core"><Private>false</Private></Reference>
  </ItemGroup>

  <Target Name="GenerateHongKongLibrary" BeforeTargets="DeployHongKongAssets" Condition="'$(NeedBuild)'">
    <Exec Command="node generate-library-script.mjs" />
  </Target>

  <Target Name="DeployHongKongAssets" AfterTargets="DeployWIP" Condition="'$(NeedBuild)'">
    <ItemGroup>
      <HongKongThemeFiles Include="SignBuilderThemes\**\*.*" Exclude="SignBuilderThemes\hk\fonts\*.woff" />
      <HongKongSymbolFiles Include="SignBuilderSymbols\**\*.*" Exclude="SignBuilderSymbols\hk\symbols\airport.svg" />
      <HongKongResourceFiles Include="Resources\**\*.*" Exclude="Resources\icon.svg;Resources\Renderer\preview.html" />
    </ItemGroup>
    <Copy SourceFiles="@(HongKongThemeFiles)" DestinationFiles="@(HongKongThemeFiles->'$(DeployDir)\SignBuilderThemes\%(RecursiveDir)%(Filename)%(Extension)')" />
    <Copy SourceFiles="@(HongKongSymbolFiles)" DestinationFiles="@(HongKongSymbolFiles->'$(DeployDir)\SignBuilderSymbols\%(RecursiveDir)%(Filename)%(Extension)')" />
    <Copy SourceFiles="@(HongKongResourceFiles)" DestinationFiles="@(HongKongResourceFiles->'$(DeployDir)\Resources\%(RecursiveDir)%(Filename)%(Extension)')" />
    <Copy SourceFiles="LICENSE;README.md;THIRD-PARTY-NOTICES.md" DestinationFolder="$(DeployDir)" />
  </Target>

  <Target Name="BuildHongKongUI" AfterTargets="DeployHongKongAssets" Condition="'$(NeedBuild)'">
    <Exec Command="npm install --no-audit --no-fund" WorkingDirectory="UI" Condition="!Exists('UI/node_modules')" />
    <Exec Command="npm run build" WorkingDirectory="UI" />
  </Target>

  <ItemGroup>
    <None Include="$(ModPropsFile)" Link="Properties\Mod.props" />
    <None Include="$(ModTargetsFile)" Link="Properties\Mod.targets" />
  </ItemGroup>
</Project>
